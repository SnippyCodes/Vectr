        <mxCell id="step-8-desc-legend" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=12;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" value="&lt;div&gt;&lt;b&gt;Automated Database Backups to S3&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;PostgreSQL dumps are streamed to S3 Standard-IA, with automated lifecycle transitions to Glacier Flexible at 30 days.&lt;/span&gt;&lt;/div&gt;" vertex="1" parent="step-8-legend">
