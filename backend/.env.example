# ============================================================
# Vectr Backend — Environment Variables
# Copy this to .env.prod on the server and fill in real values
# NEVER commit .env.prod to git
# ============================================================

# ── Database ─────────────────────────────────────────────────
# For production (PostgreSQL on Lightsail via Docker):
ENDPOINT=postgres
DB_USER=vectr
DB_PASSWORD=your_strong_postgres_password_here
DB_NAME=vectr_production

# For local development (SQLite fallback — leave ENDPOINT as localhost):
# ENDPOINT=localhost

# ── AI Providers ─────────────────────────────────────────────
# Primary: Groq (free, blazing fast)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback providers (ai_service.py auto-routes if primary fails)
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ── AWS (for S3 backup script) ───────────────────────────────
AWS_ACCESS_KEY_ID=your_iam_access_key_here
AWS_SECRET_ACCESS_KEY=your_iam_secret_key_here
AWS_REGION=us-east-1
S3_BACKUP_BUCKET=vectr-production-backups

# ── Security ─────────────────────────────────────────────────
ENCRYPTION_KEY=your_fernet_encryption_key_here

# ── Auth Providers ───────────────────────────────────────────
FIREBASE_API_KEY=your_firebase_api_key_here
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── App Config ───────────────────────────────────────────────
# Frontend URL (used for OAuth redirect URIs)
FRONTEND_URL=https://vectropensource.me
